# agni-api: subscription and cost-control settings. A TEMPLATE, not a live file.
# Set these in Vercel > agni-api > Settings > Environment Variables.
# Nothing here is a secret except where marked; never commit real secrets.

# --- Launch switches -------------------------------------------------------
# false until the release that ships the App Store products. While false every
# attested caller is metered as "beta" ($1/day cost cap, no Free/Pro counts).
BILLING_ENFORCED=false
# Stops Free AI on its own, before anything a subscriber pays for.
FREE_AI_ENABLED=true
# TestFlight AND App Review purchases are Sandbox, so this STAYS true after
# launch. Sandbox is isolated (sbx: subjects, its own daily budget, never a
# paid subscriber). false is an emergency switch only: it fails App Review.
ALLOW_SANDBOX_TRANSACTIONS=true
# Existing switches, unchanged: AI_ENABLED, RESEARCH_ENABLED, LEGACY_TOKEN_ENABLED.

# --- Products ---------------------------------------------------------------
APP_BUNDLE_ID=com.shinethankappan.agni
# REQUIRED before any Production purchase can verify: App Store Connect > the
# app > App Information > Apple ID (a number). Unset = Production refused.
APP_APPLE_ID=
PRODUCT_ID_MONTHLY=com.shinethankappan.agni.pro.monthly
PRODUCT_ID_ANNUAL=com.shinethankappan.agni.pro.annual

# --- Allowances (provisional; JSON merged over the defaults in api/_billing.js)
# Example: raise Pro photos to 120 without a deploy.
# ALLOWANCES_JSON={"pro":{"photo":120}}
ALLOWANCES_JSON={}
UNCREDITED_DAY_CAP=60
MAX_CALLS_PER_ACTION=4
MAX_INSTALLS_PER_SUBSCRIPTION=10
# Calls one subject may have in flight at once (bounds any misestimate).
MAX_OPEN_RESERVATIONS=4
# BETA ONLY, while builds 174/175 use the shared token on research and
# ingredient: their $0.50/day legacy bound can stop a tester after a handful
# of web lookups. Loosen it for the beta, tighten before retiring the token:
# ALLOWANCES_JSON={"legacy":{"dayCostCapUSD":2}}

# --- Pricing (per million tokens; override when the provider changes prices)
# PRICING_JSON={"claude-sonnet-5":{"input":2,"output":10}}
WEB_SEARCH_USD=0.01

# --- Prompt caching (OFF until tools/measure-prompt-cache.mjs shows a saving)
PROMPT_CACHE_FEATURES=

# --- Abuse limits ------------------------------------------------------------
LEGACY_PER_IP_10MIN=300
ATTEST_CHALLENGES_PER_IP_MINUTE=120
ATTEST_REGISTRATIONS_PER_IP_HOUR=20
ATTEST_REGISTRATIONS_PER_HOUR=2000
# SECRET: any long random string. Hashes IPs before they reach the database.
IP_HASH_SALT=

# --- Alerts -----------------------------------------------------------------
# Optional. Receives {"text": "...", "detail": {...}} on ceiling crossings
# (50/80/100%), tier degradation, registration floods and shared subscriptions.
# Every alert is also logged with the prefix [agni-alert].
ALERT_WEBHOOK_URL=

# --- DeviceCheck (optional; closes the Free sample across reinstall) --------
# A DeviceCheck key from developer.apple.com > Keys. SECRET: the .p8 contents,
# newlines as \n.
DEVICECHECK_KEY_ID=
DEVICECHECK_TEAM_ID=B2WG3MN7S3
DEVICECHECK_PRIVATE_KEY=

# --- The emergency ceiling lives in the DATABASE, not here -------------------
# agni_budget_config: base_ceiling_usd, per_paid_subscriber_usd,
# hard_max_ceiling_usd, max_daily_growth, free_share, trial_share,
# legacy_day_cap_usd, sandbox_day_cap_usd. See the implementation report for operator SQL.
